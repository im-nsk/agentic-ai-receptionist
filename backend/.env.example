# Copy to .env — never commit real secrets.

# --- Resend (transactional email) ---
# Create API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Production: MUST be an address on a domain you verified at https://resend.com/domains
# Do NOT use onboarding@resend.dev in production (only sends to your Resend account email).
RESEND_FROM="AI Receptionist <noreply@wrixio.com>"

# Optional reply-to for OTP / password emails
# RESEND_REPLY_TO=support@yourdomain.com

# development | production  (also respects APP_ENV=production)
ENVIRONMENT=development

# Google: JSON key for the booking service account (used server-side only).
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","client_email":"..."}
#
# Optional override for GET /public/config (otherwise client_email is read from GOOGLE_CREDENTIALS_JSON).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=ai-receptionist-service@project.iam.gserviceaccount.com

# --- Twilio (single test number → assign to one client via /admin/twilio/assign) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+15551234567
# Post-booking confirmation SMS (off by default)
ENABLE_SMS=false
# Secret for admin assignment routes (header: X-Admin-Secret)
TWILIO_ADMIN_SECRET=change-me-in-production

# --- VAPI (multi-tenant voice) ---
# Webhook auth header: x-api-key
VAPI_API_KEY=change-me-in-production
#
# One generic VAPI assistant (minimal static prompt — no "clinic" branding).
# Per-call business context is injected via assistant-request (see backend/docs/VAPI_ARCHITECTURE.md).
VAPI_BASE_ASSISTANT_ID=
# true (default) = return full inline assistant on assistant-request (replaces dashboard prompt).
# false = merge via assistantId + assistantOverrides only (dashboard prompt may still win).
VAPI_USE_INLINE_ASSISTANT=true
#
# Phone number in VAPI dashboard:
#   assistantId = null
#   server.url = POST https://YOUR_BACKEND_HOST/vapi/webhook
#   header x-api-key = VAPI_API_KEY
#
# Tool setup reference: GET https://YOUR_BACKEND_HOST/vapi/tools/schema
# Tools must use POST (not GET) to /vapi/webhook.
#
# Optional inline-assistant fallback if VAPI_BASE_ASSISTANT_ID is empty:
# VAPI_MODEL_PROVIDER=openai
# VAPI_MODEL_NAME=gpt-4o
# VAPI_VOICE_PROVIDER=11labs
# VAPI_VOICE_ID=
# VAPI_FIRST_MESSAGE_TEMPLATE=Thank you for calling {{business_name}}. How can I help you today?
#
# Tenant routing fallbacks (single-tenant testing):
# VAPI_DEFAULT_CLIENT_ID=
# VAPI_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=
# TWILIO_PHONE=+1...
