# Copy to .env — never commit real secrets.

# --- Resend (transactional email) ---
# Create API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Production: MUST be an address on a domain you verified at https://resend.com/domains
# Do NOT use onboarding@resend.dev in production (only sends to your Resend account email).
RESEND_FROM="AI Receptionist <noreply@wrixio.com>"

# Optional reply-to for OTP / password emails
# RESEND_REPLY_TO=support@yourdomain.com

# development | production  (also respects APP_ENV=production)
ENVIRONMENT=development

# Google: JSON key for the booking service account (used server-side only).
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","client_email":"..."}
#
# Optional override for GET /public/config (otherwise client_email is read from GOOGLE_CREDENTIALS_JSON).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=ai-receptionist-service@project.iam.gserviceaccount.com

# --- Twilio (single test number → assign to one client via /admin/twilio/assign) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+15551234567
# Secret for admin assignment routes (header: X-Admin-Secret)
TWILIO_ADMIN_SECRET=change-me-in-production
